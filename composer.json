{
    "name": "ratingstar/contao-seal-bundle",
    "description": "RatingStar-Siegel und Google-Sterne (Rich Snippets) für Contao.",
    "type": "contao-bundle",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "RatingStar\\ContaoSealBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "RatingStar\\ContaoSealBundle\\ContaoManager\\Plugin"
    }
}
