{
    "name": "ratingstar/contao-seal-bundle",
    "description": "RatingStar-Siegel, Bewertungs-Widgets und Google-Sterne (Rich Snippets) für Contao.",
    "type": "contao-bundle",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "contao",
        "contao-bundle",
        "ratingstar",
        "reviews",
        "customer reviews",
        "review widget",
        "rich snippets",
        "seal"
    ],
    "homepage": "https://ratingstar.de/plugins",
    "authors": [
        {
            "name": "Baumgärtner Marketing GmbH",
            "homepage": "https://bm1.de"
        }
    ],
    "support": {
        "issues": "https://github.com/BM1-de/ratingstar-contao/issues",
        "source": "https://github.com/BM1-de/ratingstar-contao",
        "docs": "https://github.com/BM1-de/ratingstar-contao#readme",
        "forum": "https://ratingstar.de/support"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3",
        "psr/cache": "^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/cache-contracts": "^3.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-client-contracts": "^3.1",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/translation-contracts": "^3.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "RatingStar\\ContaoSealBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "RatingStar\\ContaoSealBundle\\ContaoManager\\Plugin"
    }
}
